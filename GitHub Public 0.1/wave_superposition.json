  "title": "波的叠加干涉",
  "params": [
    { "key": "A1", "label": "波 1 振幅 A₁", "min": 0.1, "max": 3, "default": 1.5, "unit": "m" },
    { "key": "A2", "label": "波 2 振幅 A₂", "min": 0.1, "max": 3, "default": 1.5, "unit": "m" },
    { "key": "omega", "label": "角频率 ω", "min": 0.5, "max": 8, "default": 2, "unit": "rad/s" },
    { "key": "k", "label": "波数 k", "min": 0.5, "max": 6, "default": 1.5, "unit": "rad/m" },
