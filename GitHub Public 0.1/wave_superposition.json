  ],
  "equation": "y = A1 * sin(k * x - omega * t) + A2 * sin(k * x - omega * t + phi)",
  "render": { "type": "superposition", "xAxis": "x", "yAxis": "y" },
  "invariants": ["y ≈ y1 + y2", "|y| ≤ A1 + A2"],
  "narrative": "调整两列波的振幅与相位差，观察相长干涉与相消干涉；叠加波形始终等于两列波之和，且不超过振幅之和。"
