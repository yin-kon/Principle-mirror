    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:templates": "node scripts/verify-templates.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5",
    "mathjs": "12.4.2",
    "lz-string": "1.5.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "cross-env": "7.0.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
