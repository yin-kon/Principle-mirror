{
  "name": "conceptlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "description": "原理镜 ConceptLens — 学科概念可交互仿真工坊（传智杯参赛作品）",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "cross-env VITE_LLM_MODE=proxy vite",
